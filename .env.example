# Copy this file to .env and fill in your token. Never commit or share .env.
DISCORD_TOKEN=paste-your-bot-token-here
# Optional:
# DEV_GUILD_ID=123456789012345678   # your server id, makes slash commands appear instantly while testing
# SYNC_HOURS=12                     # how often linked collections re-sync
# ENABLE_BRACKET_LOOKUP=true        # lets people type [[Card Name]] in chat (needs Message Content intent)
# DB_PATH=collections.db
